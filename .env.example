# Template for local docker-compose usage.
#
# Copy this file to `.env` (already gitignored) and fill in real values:
#   cp .env.example .env
#
# Docker Compose loads `.env` from this directory automatically. Never commit
# the real `.env` file or put real credentials in this template.
#
# In a real deployment these same variable names would instead be injected by
# the platform's secret store (e.g. AWS Secrets Manager via ECS task
# definition secrets, or a Kubernetes Secret mounted as environment
# variables) rather than a .env file - the application only ever reads
# environment variables, so no code or config changes are needed to switch.

POSTGRES_DB=opspilot
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=changeme